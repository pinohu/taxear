# TaxEar Study — set these on the study.taxear.com Cloudflare Pages project
# (Settings → Environment variables; mark secrets as secret). Nothing here is read
# from a file at runtime; this only documents the names. See docs/REVENUE_BUILD.md.

# Stripe. The webhook endpoint is https://study.taxear.com/api/stripe-webhook and
# should subscribe to: checkout.session.completed, invoice.paid,
# customer.subscription.deleted, charge.refunded, charge.dispute.created.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dashboard Price IDs (price_...). One-time: twelve months of access. Subscriptions:
# the Practitioner alert tier.
STRIPE_PRICE_P1=
STRIPE_PRICE_P2=
STRIPE_PRICE_P3=
STRIPE_PRICE_ALL=
STRIPE_PRICE_PRACTITIONER_MONTH=
STRIPE_PRICE_PRACTITIONER_YEAR=

# Displayed on the landing page; must match the Prices above. Public.
PUBLIC_PRICE_PART=$29
PUBLIC_PRICE_ALL=$59

# Signs the access cookie and sign-in links. `openssl rand -hex 32`.
COOKIE_SECRET=

# Transactional email (sign-in links, change alerts). MAIL_FROM must be a verified
# sender on the Resend account, e.g. "TaxEar Study <study@taxear.com>".
RESEND_API_KEY=
MAIL_FROM=

# Shared with the GitHub Action that announces material changes (PR 3).
NOTIFY_SECRET=

# Plus a KV namespace bound as ACCESS_KV (Settings → Functions → KV bindings).
