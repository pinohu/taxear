---
import '../styles/study.css';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  {/* Same before-paint theme read as the main site: an explicit saved choice wins
      before anything renders; otherwise prefers-color-scheme in study.css handles it. */}
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark' || t === 'light-hc' || t === 'dark-hc') {
          document.documentElement.setAttribute('data-theme', t);
        }
      } catch (e) {}
    })();
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | TaxEar Study</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <header class="site-head"><div class="wrap">
    <a class="brand" href="/">Tax<span>Ear</span> Study</a>
    <nav class="nav">
      <a href="https://taxear.com/">← Back to the reference site</a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Colour theme"></button>
    </nav>
  </div></header>
  <script is:inline>
    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      var order = ['auto', 'light', 'dark', 'light-hc', 'dark-hc'];
      var labels = { auto: 'Auto', light: 'Light', dark: 'Dark', 'light-hc': 'Light HC', 'dark-hc': 'Dark HC' };
      function current() {
        try {
          var t = localStorage.getItem('theme');
          return order.indexOf(t) > 0 ? t : 'auto';
        } catch (e) { return 'auto'; }
      }
      function label(mode) { return labels[mode]; }
      function longLabel(mode) {
        return mode === 'auto' ? 'matching your system' : mode === 'light' ? 'light'
          : mode === 'dark' ? 'dark' : mode === 'light-hc' ? 'light, high contrast'
          : 'dark, high contrast';
      }
      function apply(mode) {
        if (mode === 'auto') document.documentElement.removeAttribute('data-theme');
        else document.documentElement.setAttribute('data-theme', mode);
        btn.textContent = label(mode);
        btn.setAttribute('aria-label', 'Colour theme: ' + longLabel(mode) + '. Click to change.');
        try {
          if (mode === 'auto') localStorage.removeItem('theme');
          else localStorage.setItem('theme', mode);
        } catch (e) {}
      }
      apply(current());
      btn.addEventListener('click', function () {
        apply(order[(order.indexOf(current()) + 1) % order.length]);
      });
    })();
  </script>
  <main class="wrap"><slot /></main>
  <footer class="site-foot"><div class="wrap">
    <p>TaxEar Study is a paid companion product: original practice questions mapped to the
      IRS Special Enrollment Examination outline. It is not affiliated with, endorsed by,
      or reviewed by the IRS or its testing vendor. Educational only.</p>
    <p>© {new Date().getFullYear()} Neat Circle LLC</p>
  </div></footer>
</body>
</html>
