---
import StudyBase from '../../layouts/StudyBase.astro';

const modules = import.meta.glob('../../data/questions/*.json', { eager: true });
const domains = Object.values(modules).map((m) => ({
  domain: m.domain, domainTitle: m.domainTitle, outlineSection: m.outlineSection,
  count: m.questions.length,
}));
---
<StudyBase title="Practice" description="Choose a domain to practice.">
  <div id="gate">
    <h1>Checking access…</h1>
  </div>
  <div id="list" style="display:none">
    <h1>Practice by domain</h1>
    <ul class="domain-list">
      {domains.map((d) => (
        <li>
          <span><span class="eyebrow">{d.outlineSection}</span><br/>{d.domainTitle} <span class="eyebrow">({d.count} questions)</span></span>
          <a class="btn" href={`/practice/${d.domain}/`}>Practice →</a>
        </li>
      ))}
    </ul>
  </div>

  <script>
    fetch('/api/access-check').then((r) => r.json()).then(({ access }) => {
      if (!access) { window.location.href = '/'; return; }
      document.getElementById('gate').style.display = 'none';
      document.getElementById('list').style.display = '';
    }).catch(() => { window.location.href = '/'; });
  </script>
</StudyBase>
