---
import StudyBase from '../layouts/StudyBase.astro';
---
<StudyBase title="Payment received" description="Confirming your purchase and unlocking access.">
  <div id="state">
    <h1>Confirming your purchase…</h1>
    <p>One moment while we verify the payment with Stripe.</p>
  </div>

  <script>
    const state = document.getElementById('state');
    const sessionId = new URLSearchParams(window.location.search).get('session_id');

    function render(html) { state.innerHTML = html; }

    if (!sessionId) {
      render('<h1>Missing payment reference</h1><p>We could not find a payment session in this link. If you just paid, check the confirmation email from Stripe, or <a href="/">try again</a>.</p>');
    } else {
      fetch('/api/verify-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId }),
      })
        .then(async (res) => {
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Could not verify payment.');
          render(`<h1>You're in</h1><p>Access is unlocked on this browser. Bookmark this device — access is tied to it until we add cross-device sign-in.</p><p><a class="btn" href="/practice/">Start practicing →</a></p>`);
        })
        .catch((e) => {
          render(`<h1>We could not confirm this payment</h1><p>${e.message}</p><p>If you were charged, this is very likely a temporary issue — contact <a href="mailto:editor@taxear.com">editor@taxear.com</a> and we'll sort it out by hand.</p>`);
        });
    }
  </script>
</StudyBase>
