---
import StudyBase from '../layouts/StudyBase.astro';
const price = { month: import.meta.env.PUBLIC_PRICE_PRACTITIONER_MONTH || '$15', year: import.meta.env.PUBLIC_PRICE_PRACTITIONER_YEAR || '$120' };
// The yearly note is computed from the displayed prices, never hard-coded, and is left
// out when either price does not parse.
const num = (s) => { const n = Number(String(s).replace(/[^0-9.]/g, '')); return Number.isFinite(n) && n > 0 ? n : null; };
const m = num(price.month), y = num(price.year);
const saving = m && y && m * 12 > y ? `save $${Math.round(m * 12 - y)} a year against monthly` : 'one renewal a year';
---
<StudyBase title="Practitioner alerts" description="Follow the rules you rely on and get one email when a page records a material change: a figure, a deadline, the rule itself.">
  <p class="eyebrow">For people who use the rules, not only study them</p>
  <h1>Follow a rule. Get told when it changes.</h1>
  <p class="lede">Every TaxEar page keeps a dated change log, and every figure carries the day its source was opened. The Practitioner subscription turns that into delivery: follow the pages you rely on, and when one of them records a <em>material</em> change, a figure, a deadline, the rule itself, you get one email that says what changed and links to the page. Editorial work never alerts. The pages, the change log and the figures stay free for everyone.</p>

  <p id="pending" class="note" hidden></p>
  <p id="error" class="error" hidden></p>

  <h2 id="pricing">Pricing</h2>
  {/* Plain forms, so the page works with scripts off: the Function creates the Stripe
      session and redirects. The hidden email and code fields are filled from the URL
      when the reader arrived from a topic page's "Follow this rule" control. */}
  <ul class="skus">
    <li><div><p class="sku-title">Monthly</p><p class="sku-meta">cancel any time · follow as many topics as you like</p></div>
      <form method="post" action="/api/checkout-redirect" class="buy-form"><input type="hidden" name="sku" value="practitioner_month" /><input type="hidden" name="email" /><input type="hidden" name="code" /><button type="submit">{price.month}<span class="per">/month</span></button></form></li>
    <li class="sku-all"><div><p class="sku-title">Yearly</p><p class="sku-meta">{saving}</p></div>
      <form method="post" action="/api/checkout-redirect" class="buy-form"><input type="hidden" name="sku" value="practitioner_year" /><input type="hidden" name="email" /><input type="hidden" name="code" /><button type="submit">{price.year}<span class="per">/year</span></button></form></li>
  </ul>
  <p class="sku-signin">Already subscribed? <a href="/account/">Sign in</a> to manage what you follow.</p>

  <h2>How it works</h2>
  <ul class="plain">
    <li>On any topic page at taxear.com, enter your address under <strong>Follow this rule</strong>. A subscriber gets a confirmation link by email; anyone else is invited to subscribe, and every topic they asked for is followed from the first alert.</li>
    <li>An alert is sent only when the editor marks a change log entry material. That happens when the annual inflation adjustments land, when legislation changes a rule, and when a deadline or procedure moves. Not when a sentence is reworded.</li>
    <li>Each email names the topic, the date, the change in one paragraph as it appears on the page, and links to the page. A stop link in every message, with a confirmation step so a mail scanner cannot press it for you.</li>
    <li>Cancel from your account page. Access runs to the end of the paid period; see the <a href="https://taxear.com/refunds/">refund policy</a>.</li>
  </ul>

  <script>
    const params = new URLSearchParams(location.search);
    const code = params.get('code'), email = params.get('email'), err = params.get('error');
    const pending = document.getElementById('pending');
    if (code) { pending.textContent = `Subscribe and topic ${code} is followed from the first alert.`; pending.hidden = false; }
    if (err) { const e = document.getElementById('error'); e.textContent = err; e.hidden = false; }
    document.querySelectorAll('form.buy-form').forEach((f) => {
      if (email) f.querySelector('input[name=email]').value = email;
      if (code) f.querySelector('input[name=code]').value = code;
    });
  </script>
</StudyBase>
