---
import '../styles/global.css';
import Digest from '../components/Digest.astro';
interface Props { title: string; description: string; noindex?: boolean; canonical?: string; jsonld?: object; ogType?: 'article' | 'website' }
const { title, description, noindex = false, jsonld, ogType = 'article' } = Astro.props;
// One site-wide share image (public/og.png, 1200×630): the wordmark on onionskin. Every
// page carries it so a shared link renders with an image instead of bare text.
const ogImage = new URL('/og.png', Astro.site).href;
// Privacy-respecting analytics, injected only when a token is configured at build time.
// Cloudflare Web Analytics sets no cookies and records no cross-site identifiers.
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  ['/individuals/', 'Individuals'], ['/businesses/', 'Businesses'], ['/representation/', 'Representation'],
  ['/forms/', 'Forms'], ['/notices/', 'IRS Notices'], ['/ea-exam/', 'EA Exam'],
];

// Site-wide identity graph: who publishes this and who edits it, as linked entities
// rather than a bare string, so a page's own jsonld (e.g. Article) can reference them
// by @id instead of repeating the name. Emitted on every page, independent of the
// page-specific jsonld prop.
export const orgId = 'https://taxear.com/#organization';
export const personId = 'https://taxear.com/about/#editor';
const identityJsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': orgId, name: 'TaxEar', legalName: 'Neat Circle LLC',
      url: 'https://taxear.com/', publishingPrinciples: 'https://taxear.com/about/',
      employee: { '@id': personId },
    },
    {
      '@type': 'Person', '@id': personId, name: 'Nnamdi O.', jobTitle: 'Editor',
      worksFor: { '@id': orgId },
      description: 'Full professor of engineering at Gannon University, preparing for the IRS Special Enrollment Examination; holds a Pennsylvania real estate license.',
    },
  ],
};
---
<!doctype html>
<html lang="en" data-pagefind-ignore={noindex ? 'true' : undefined}>
<head>
  {/* Runs before anything paints: if the reader has an explicit theme choice saved,
      set it before first paint so there's no flash of the other theme. Absent a
      saved choice, prefers-color-scheme in global.css handles it with no JS at all. */}
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark' || t === 'light-hc' || t === 'dark-hc') {
          document.documentElement.setAttribute('data-theme', t);
        }
      } catch (e) {}
    })();
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} | TaxEar</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content="TaxEar" />
  <meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="TaxEar — federal tax law and IRS procedure, cited and verified" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImage} />
  {/* Fonts are self-hosted from public/fonts; the @font-face rules live in global.css.
      Source Serif 4 sets both text and headings, so its latin face is the one that blocks first paint. */}
  <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(identityJsonld)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <header class="site-head"><div class="wrap">
    <a class="brand" href="/">Tax<span>Ear</span></a>
    <nav class="nav" aria-label="Primary">
      {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      <a href="/search/" aria-current={path === '/search/' ? 'page' : undefined}>Search</a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Colour theme"></button>
    </nav>
  </div></header>
  <script is:inline>
    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      var order = ['auto', 'light', 'dark', 'light-hc', 'dark-hc'];
      var labels = { auto: 'Auto', light: 'Light', dark: 'Dark', 'light-hc': 'Light HC', 'dark-hc': 'Dark HC' };
      function current() {
        try {
          var t = localStorage.getItem('theme');
          return order.indexOf(t) > 0 ? t : 'auto';
        } catch (e) { return 'auto'; }
      }
      function label(mode) { return labels[mode]; }
      function longLabel(mode) {
        return mode === 'auto' ? 'matching your system' : mode === 'light' ? 'light'
          : mode === 'dark' ? 'dark' : mode === 'light-hc' ? 'light, high contrast'
          : 'dark, high contrast';
      }
      function apply(mode) {
        if (mode === 'auto') document.documentElement.removeAttribute('data-theme');
        else document.documentElement.setAttribute('data-theme', mode);
        btn.textContent = label(mode);
        btn.setAttribute('aria-label', 'Colour theme: ' + longLabel(mode) + '. Click to change.');
        try {
          if (mode === 'auto') localStorage.removeItem('theme');
          else localStorage.setItem('theme', mode);
        } catch (e) {}
      }
      apply(current());
      btn.addEventListener('click', function () {
        apply(order[(order.indexOf(current()) + 1) % order.length]);
      });
    })();
  </script>
  <main class="wrap" data-pagefind-body><slot /></main>
  <div class="wrap"><Digest /></div>
  <footer class="site-foot"><div class="wrap">
    <p><strong>TaxEar</strong> is a reference on federal tax law and IRS procedure, organized by the IRS Special Enrollment Examination content outline. Every page cites primary authority and shows its verification date. Educational only; not legal or tax advice for your situation.</p>
    <p><a href="/about/">About &amp; editorial policy</a> · <a href="/ea-exam/">EA exam guide</a> · <a href="https://study.taxear.com/">Practice exams</a> · <a href="/changes/">What changed this year</a> · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/refunds/">Refunds</a> · © {new Date().getFullYear()} TaxEar / Neat Circle LLC</p>
  </div></footer>
  {cfBeacon && <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: cfBeacon })}></script>}
</body>
</html>
