---
import '../styles/global.css';
interface Props { title: string; description: string; noindex?: boolean; canonical?: string; jsonld?: object }
const { title, description, noindex = false, jsonld } = Astro.props;
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  ['/individuals/', 'Individuals'], ['/businesses/', 'Businesses'], ['/representation/', 'Representation'],
  ['/forms/', 'Forms'], ['/notices/', 'IRS Notices'], ['/ea-exam/', 'EA Exam'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | TaxEar</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:type" content="article" /><meta property="og:url" content={canonical} /><meta property="og:site_name" content="TaxEar" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&family=Public+Sans:wght@400;600&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <header class="site-head"><div class="wrap">
    <a class="brand" href="/">Tax<span>Ear</span></a>
    <nav class="nav" aria-label="Primary">
      {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div></header>
  <main class="wrap"><slot /></main>
  <footer class="site-foot"><div class="wrap">
    <p><strong>TaxEar</strong> is a reference on federal tax law and IRS procedure, organized by the IRS Special Enrollment Examination content outline. Every page cites primary authority and shows its verification date. Educational only; not legal or tax advice for your situation.</p>
    <p><a href="/about/">About &amp; editorial policy</a> · <a href="/ea-exam/">EA exam guide</a> · <a href="/changes/">What changed this year</a> · © {new Date().getFullYear()} TaxEar / Neat Circle LLC</p>
  </div></footer>
</body>
</html>
