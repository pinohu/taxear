---
import Base from '../../layouts/Base.astro';
import Rail from '../../components/Rail.astro';
import Stamp from '../../components/Stamp.astro';
import DiagramMount from '../../components/diagrams/DiagramMount.astro';
import NewsTracking from '../../components/NewsTracking.astro';
import { getCollection, render } from 'astro:content';
import { allTopics, idOf, topicByCode, publishedCodes } from '../../lib';
import { checkYourself, answerText } from '../../checkyourself';
import { orgId, personId } from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const entries = await getCollection('topics');
  return entries.map(entry => {
    const t = allTopics.find(x => idOf(x) === entry.id.replace(/\.md$/, ''));
    if (!t) return null;
    return { params: { part: t.part.slug, rest: `${t.domain.slug}/${t.section.slug}/${t.slug}` }, props: { entry, t } };
  }).filter(Boolean);
}
const { entry, t } = Astro.props;
const { Content } = await render(entry);
const d = entry.data; const published = d.status === 'published';
const live = await publishedCodes(getCollection);
const related = d.related.filter(c => live.has(c)).map(topicByCode).filter(Boolean);
const abs = (p) => new URL(p, Astro.site).href;
const questions = checkYourself(entry.body ?? '');

const article = { '@type': 'Article', headline: d.title, description: d.description,
  dateModified: d.lastReviewed, author: { '@id': personId }, publisher: { '@id': orgId },
  isPartOf: { '@type': 'WebSite', name: 'TaxEar', url: 'https://taxear.com/' },
  about: `IRS SEE outline ${d.code}`,
  citation: d.authorities.map(a => [a.type === 'Reg' ? 'Treas. Reg. §' : a.type === 'Circ230' ? 'Circular 230' : a.type, a.ref, a.title].filter(Boolean).join(' ')) };

const breadcrumb = { '@type': 'BreadcrumbList', itemListElement: [
  ['TaxEar', '/'],
  [`Part ${t.part.part}: ${t.part.name}`, `/${t.part.slug}/`],
  [t.section.title, `/${t.part.slug}/#${t.section.slug}`],
  [d.title, t.path],
].map(([name, href], i) => ({ '@type': 'ListItem', position: i + 1, name, item: abs(href) })) };

// FAQ structured data only on indexed pages, and only from the page's own visible questions.
const faq = published && questions.length > 0 ? { '@type': 'FAQPage', mainEntity: questions.map(q => ({
  '@type': 'Question', name: q.question,
  acceptedAnswer: { '@type': 'Answer', text: answerText(q) },
})) } : null;

const jsonld = { '@context': 'https://schema.org', '@graph': [article, breadcrumb, faq].filter(Boolean) };
---
<Base title={d.title} description={d.description} noindex={!published} jsonld={jsonld}>
  <p class="crumbs"><a href="/">TaxEar</a><span>›</span><a href={`/${t.part.slug}/`}>Part {t.part.part}</a><span>›</span><a href={`/${t.part.slug}/#${t.section.slug}`}>{t.section.title}</a></p>
  <div class="page">
    <article>
      <p class="eyebrow"><b>{d.domain}</b> · {d.section}</p>
      <h1>{d.title}</h1>
      <Stamp data={d} band={true} />
      {!published && <div class="callout trap"><p class="callout-label">Not yet verified</p><p>This page is {d.status === 'stub' ? 'a placeholder' : `in ${d.status}`} and is not indexed. It has not completed the source, currency, and editorial checks in the <a href="/about/">editorial policy</a>.</p></div>}
      {d.diagram && <DiagramMount diagram={d.diagram} />}
      <Content />
      {d.changelog.length > 0 && <section><h2>Change log</h2><ul class="changelog">{d.changelog.map(c => <li><time>{c.date}</time>{c.summary}</li>)}</ul></section>}
      {related.length > 0 && <section><h2>Related topics</h2><ul>{related.map(r => <li><a href={r.path}>{r.title}</a> <span class="eyebrow">{r.code}</span></li>)}</ul></section>}
      {published && d.newsQuery && <NewsTracking query={d.newsQuery} />}
    </article>
    <Rail data={d} />
  </div>
</Base>
