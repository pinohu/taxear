# Build-time configuration for the static site. Set these in the Cloudflare Pages
# project (Settings → Environment variables), not in the repo — this file only
# documents the names. Both are optional: when unset, the feature is not rendered.
# See docs/LAUNCH.md.

# Endpoint the "what changed this year" form posts to, from whichever email
# provider is chosen. Unset = the form is not rendered at all.
PUBLIC_DIGEST_ENDPOINT=

# Cloudflare Web Analytics site token. No cookies, no cross-site identifiers.
# Unset = no analytics script is emitted.
PUBLIC_CF_BEACON_TOKEN=
